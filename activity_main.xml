<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="14dp"
        android:background="#E6121824"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBrandTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NAVIPRO 3D // NEXT-GEN"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGnssBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1A2E22"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="GNSS + KALMAN: 3D FIX"
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:checkedButton="@id/btnModeTaxi"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeTaxi"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="ТАКСИ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:strokeColor="#FFD600" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeDelivery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="ДОСТАВКА"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:strokeColor="#00FF88" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeRestaurant"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="РЕСТОРАН"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:strokeColor="#FF5252" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvModeDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Режим Такси: Карманы посадки без штрафов (3.27) + 3D-подъезды"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimDrive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#00E5FF"
            android:text="ТЕСТ-ДРАЙВ"
            android:textColor="#090D16"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPitchToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="3D УГОЛ 65°"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1E293B"
            android:text="МОЙ GPS"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:background="#F0121824"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvTargetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ТОЧКА ПОСАДКИ: Подъезд №3 • Карман разрешен"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTargetSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Полоса 2 (Прямо) • Шлагбаум: Авто-открытие по звонку • 140 м"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
